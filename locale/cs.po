# File: big-remote-play/usr/share/big-remote-play/ui/guest_view.py, line: 384
#: src/big_remote_play/ui/guest_view.py:1163
msgid "Use IPv6"
msgstr "Použijte IPv6"

#: src/big_remote_play/ui/connection_guides.py:70
msgid ""
"Use Sunshine’s port configuration and the official setup guide. With IPv4, "
"forward the streaming ports to the game computer and allow them in its "
"firewall; IPv6 needs appropriate firewall rules. UPnP is only an attempt, "
"not proof that access works. Do not expose the Sunshine administration panel "
"(47990 by default), and do not disable the firewall."
msgstr ""
"Použijte nastavení portů Sunshine a oficiálního průvodce. U IPv4 přesměrujte "
"streamovací porty na herní počítač a povolte je v jeho bráně firewall; IPv6 "
"vyžaduje vhodná pravidla brány firewall. UPnP je pouze pokus, nikoli důkaz, "
"že přístup funguje. Nevystavujte panel pro správu Sunshine (ve výchozím "
"nastavení port 47990) a nevypínejte bránu firewall."

#: src/big_remote_play/ui/guest_view.py:1500
msgid "Use a number between 1 and 65535."
msgstr "Použijte číslo od 1 do 65535."

#: src/big_remote_play/ui/connection_guides.py:56
msgid ""
"Use an existing domain or register one. Services such as DigitalPlat offer "
"free public domain names, subject to availability, renewal rules and terms. "
"This is optional: a reachable public IP also works without a domain."
msgstr ""
"Použijte existující doménu nebo si zaregistrujte novou. Služby jako "
"DigitalPlat nabízejí bezplatné veřejné názvy domén podle dostupnosti, "
"pravidel obnovení a podmínek. Je to volitelné: dostupná veřejná IP adresa "
"funguje i bez domény."

#: src/big_remote_play/ui/guest_view.py:222
msgid "Use hardware decoding when available"
msgstr "Používat hardwarové dekódování, je-li dostupné"

#: src/big_remote_play/ui/guest_view.py:418
msgid "Use multiple controllers"
msgstr "Používat více ovladačů"

#: src/big_remote_play/ui/guest_view.py:295
msgid "Use only when both computers and the screen support HDR."
msgstr "Používejte pouze tehdy, když HDR podporují oba počítače i obrazovka."

#: src/big_remote_play/ui/connection_guides.py:115
msgid ""
"Use the administrator’s server address and authorization method. Once the "
"computers can reach one another privately, share on the game computer and "
"connect using its VPN address. Keep the Sunshine administration panel "
"private."
msgstr ""
"Použijte adresu serveru a způsob autorizace od správce. Jakmile se počítače "
"mohou navzájem soukromě spojit, sdílejte hru na herním počítači a připojte "
"se pomocí jeho adresy VPN. Panel pro správu Sunshine ponechte soukromý."

#: src/big_remote_play/ui/private_network_view.py:961
