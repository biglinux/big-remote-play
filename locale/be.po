msgstr ""
"Дамен — гэта імя накшталт example.com. Ваш сервер атрымлівае імя ўнутры яго, "
"напрыклад headscale.example.com."

#: src/big_remote_play/ui/headscale_wizard.py:1457
msgid "A key for the other computer"
msgstr "Ключ для іншага камп’ютара"

#: src/big_remote_play/ui/headscale_wizard.py:1257
msgid "A key that adds one computer. It is used once and not saved."
msgstr ""
