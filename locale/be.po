#: src/big_remote_play/ui/api_access_dialog.py:40
msgid ""
"This is an auth key. An auth key adds a computer to a network; it cannot "
"manage the network. Create an API access token instead."
msgstr ""
"Гэта ключ аўтэнтыфікацыі. Ён дадае камп’ютар у сетку, але не можа кіраваць "
"сеткай. Замест яго стварыце токен доступу да API."

#: src/big_remote_play/ui/network_devices.py:420
msgid "This is not a code from the other device."
msgstr "Гэта не код з іншай прылады."

#: src/big_remote_play/ui/headscale_wizard.py:506
msgid "This is not a domain."
msgstr "Гэта не дамен."

#: src/big_remote_play/ui/headscale_wizard.py:734
msgid "This is not a public IP address."
msgstr "Гэта не публічны IP-адрас."

#: src/big_remote_play/ui/headscale_wizard.py:83
msgid "This is not a server address."
msgstr "Гэта не адрас сервера."

#: src/big_remote_play/ui/headscale_wizard.py:1290
msgid "This is not an API key."
msgstr "Гэта не ключ API."

#: src/big_remote_play/ui/zerotier_join.py:59
msgid ""
"This is taking longer than usual. Check that the code is right. If it is, "
"the network may be offline; this computer keeps trying."
msgstr ""
