#: src/big_remote_play/ui/vpn_accounts_dialog.py:156
#: src/big_remote_play/ui/zerotier_join.py:107
msgid "Allow"
msgstr "Дазволіць"

#: src/big_remote_play/ui/host_view.py:714
msgid ""
"Allow HEVC/AV1 when supported. The other computer chooses a compatible codec."
msgstr ""
"Дазволіць HEVC/AV1, калі падтрымліваецца. Іншы камп'ютар выбірае сумяшчальны "
"кодэк."

#: src/big_remote_play/ui/connection_guides.py:128
msgid ""
"Allow HTTPS (443/TCP) and, when using the embedded relay, STUN (3478/UDP) on "
"the server firewall. These are not Sunshine's streaming ports, and the game "
"computer needs no open port for this."
msgstr ""
"Дазвольце ў брандмаўэры сервера HTTPS (443/TCP), а пры выкарыстанні "
"ўбудаванага рэтранслятара — STUN (3478/UDP). Гэта не парты трансляцыі "
"Sunshine, і гульнявому камп’ютару для гэтага не трэба адкрываць парты."

#: src/big_remote_play/ui/sunshine_preferences.py:622
msgid "Allow Slow HEVC Encoding"
msgstr "Дазволіць павольнае кадаванне HEVC"

#: src/big_remote_play/ui/host_view.py:3538
msgid "Allow Sunshine through the firewall?"
msgstr "Дазволіць Sunshine у брандмаўэры?"

#: src/big_remote_play/ui/sunshine_preferences.py:693
msgid "Allow fallback to software encoding"
msgstr "Дазволіць пераход на праграмнае кадаванне"

#: src/big_remote_play/ui/host_view.py:1047
#: src/big_remote_play/ui/support_center.py:56
msgid "Allow in firewall"
msgstr "Дазволіць у брандмаўэры"

#: src/big_remote_play/ui/host_view.py:850
msgid "Allow internet access to administration"
msgstr "Дазволіць адміністраванне праз інтэрнэт"

#: src/big_remote_play/ui/zerotier_join.py:51
msgid ""
"Allow it once so Big Remote Play can follow the connection. Your password "
"may be requested."
msgstr ""
"Дазвольце адзін раз, каб Big Remote Play мог сачыць за падключэннем. Можа "
"спатрэбіцца пароль."

#: src/big_remote_play/ui/provider_page.py:166
#: src/big_remote_play/ui/remote_connection.py:63
msgid ""
"Allow it once to see and use your networks. Your password may be requested."
msgstr ""
"Дазвольце гэта адзін раз, каб бачыць і выкарыстоўваць свае сеткі. Можа "
"спатрэбіцца пароль."

#: src/big_remote_play/ui/zerotier_join.py:86
msgid ""
"Allow it once to use ZeroTier on this computer. Your password may be "
"requested."
msgstr ""
"Дазвольце адзін раз, каб выкарыстоўваць ZeroTier на гэтым камп’ютары. Можа "
"спатрэбіцца пароль."

#: src/big_remote_play/ui/tailscale_accounts.py:70
#: src/big_remote_play/ui/vpn_accounts_dialog.py:153
msgid ""
"Allow it once. Your password is requested; afterwards Tailscale works "
"without it."
msgstr ""
"Дазвольце адзін раз. Будзе запытаны пароль; пасля гэтага Tailscale працуе "
"без яго."

#: src/big_remote_play/ui/headscale_wizard.py:1195
msgid ""
"Allow ports 80 and 443 (TCP) in the server's firewall and in your VPS "
"provider's panel."
msgstr ""
"Дазвольце парты 80 і 443 (TCP) у брандмаўэры сервера і ў панэлі вашага "
"правайдара VPS."

#: src/big_remote_play/ui/headscale_wizard.py:793
msgid "Allow web connections in the firewall"
msgstr "Дазволіць вэб-злучэнні ў брандмаўэры"

#: src/big_remote_play/ui/host_view.py:1323
msgid "Allow, pause or remove devices that can connect"
msgstr "Дазваляйце, прыпыняйце або выдаляйце прылады, якія могуць падключацца"

#: src/big_remote_play/ui/host_view.py:3425
#: src/big_remote_play/ui/sunshine_preferences.py:692
msgid "Allowed"
msgstr "Дазволена"

#: src/big_remote_play/ui/sunshine_preferences.py:514
msgid "Allows guests to control the host system with a gamepad / controller"
msgstr ""
"Дазваляе гасцям кіраваць гульнявым камп’ютарам з дапамогай геймпада або "
"кантролера"

#: src/big_remote_play/ui/sunshine_preferences.py:520
msgid "Allows guests to control the host system with the keyboard"
msgstr "Дазваляе гасцям кіраваць гульнявым камп’ютарам з дапамогай клавіятуры"

#: src/big_remote_play/ui/sunshine_preferences.py:521
msgid "Allows guests to control the host system with the mouse"
msgstr "Дазваляе гасцям кіраваць гульнявым камп’ютарам з дапамогай мышы"

#: src/big_remote_play/ui/guest_view.py:493
msgid "Allows more than one controller to be sent to the game PC."
msgstr "Дазваляе перадаваць на гульнявы камп'ютар больш за адзін кантролер."

#: src/big_remote_play/ui/guest_view.py:381
msgid "Allows unusually high values. Use only on a fast, stable network."
msgstr ""
"Дазваляе незвычайна высокія значэнні. Выкарыстоўвайце толькі ў хуткай і "
"стабільнай сетцы."

#: src/big_remote_play/ui/sunshine_preferences.py:680
msgid ""
"Allows you to select the entropy encoding to prioritize quality or encoding "
"speed. H.264 only."
msgstr ""
"Дазваляе выбраць энтрапійнае кадаванне з прыярытэтам якасці або хуткасці "
"кадавання. Толькі H.264."

#: src/big_remote_play/ui/zerotier_join.py:76
msgid "Almost there"
msgstr "Амаль гатова"

#: src/big_remote_play/ui/private_network_view.py:511
msgid "Already connected"
msgstr "Ужо падключана"

#: src/big_remote_play/ui/controls_help.py:210
msgid "Also Apple TV, whose remote moves the pointer and clicks."
msgstr "А таксама Apple TV: яго пульт перамяшчае ўказальнік і пстрыкае."

#: src/big_remote_play/ui/guest_view.py:427
msgid "Also play sound on the game PC"
msgstr "Прайграваць гук таксама на гульнявым камп'ютары"

#: src/big_remote_play/ui/host_view.py:756
msgid "Also play sound on this computer"
msgstr "Прайграваць гук таксама на гэтым камп’ютары"

#: src/big_remote_play/ui/host_view.py:844
msgid "Also use IPv6"
msgstr "Выкарыстоўваць таксама IPv6"

