#: src/big_remote_play/ui/network_devices.py:444
msgid "A new device cannot use the network until it is approved."
msgstr ""
"Μια νέα συσκευή δεν μπορεί να χρησιμοποιήσει το δίκτυο μέχρι να εγκριθεί."

#: src/big_remote_play/ui/network_dashboard.py:226
