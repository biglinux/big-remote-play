#: src/big_remote_play/ui/host_view.py:355
msgid ""
"0 follows the other computer’s request. This limits video, not total network "
"traffic."
msgstr ""
"0 usa o valor solicitado pelo outro computador. O limite vale para o vídeo, "
"não para todo o tráfego da rede."

