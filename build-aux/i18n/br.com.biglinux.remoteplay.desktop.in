[Desktop Entry]
Name=Big Remote Play
# TRANSLATORS: Generic application category shown by app menus and software centers.
GenericName=Game Streaming
Comment=Play games together over a local or private network
Exec=/usr/bin/big-remote-play
Icon=br.com.biglinux.remoteplay
StartupWMClass=br.com.biglinux.remoteplay
StartupNotify=true
Terminal=false
Type=Application
Categories=Game;
# TRANSLATORS: Search terms separated by semicolons; keep the final semicolon. Keep Sunshine, Moonlight and VPN, add common local words.
Keywords=game;remote;play;stream;streaming;Sunshine;Moonlight;VPN;
X-GNOME-UsesNotifications=true
